# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.venv/
venv/
*.egg

# Data files (can be large)
/data/
*.ply
*.las
*.laz
*.pcd
*.xyz
*.pts
*.e57

# Datasets — large export/staging trees that must never enter history.
/dataset/
/dataset_*/
/verse_labels/

# Research proposal artifacts (kept local; sources of truth live elsewhere).
/Lithium_Research_Proposal.docx
/Lithium_Research_Proposal.pdf
/proposal.js
/proposal_pdf.py

# IDE
.vscode/
.idea/
*.swp
*.swo

# Output / renders
/output/
/export/

# Multi-agent audit artifacts (cartography output, sweep findings, reports)
/_audit/

# Training — third-party Pointcept clone + run artifacts.
# We clone Pointcept into training/pointcept as a git-untracked
# sibling (see docs/training_setup.md); it's hundreds of MB of
# third-party source + compiled CUDA extensions and must never
# enter our history.
/training/
# Common ML checkpoint + log extensions in case a run writes
# somewhere other than training/.
*.pth
*.pt
*.ckpt
/runs/
/exp/
/checkpoints/

# Claude Code
.claude/

# OS
Thumbs.db
.DS_Store

# Stray personal notes that landed at the repo root.
/qa.html

# Environment
.env
*.log

# Node (if used)
node_modules/

# Build artifacts
*.dll
*.pyd
*.whl

# Smoke-test outputs (regenerated by tools/smoke_session.py)
/_smoke_output/
/_preview/
